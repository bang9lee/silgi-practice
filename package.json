{
  "name": "silgi-practice",
  "productName": "SilgiPractice",
  "version": "1.0.0",
  "description": "네트워크관리사 2급 · PC정비사 2급 실기 연습 (개인 공부용, 오프라인)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:ui": "node test/ui/e2e.js",
    "convert": "node tools/convert-silgi-data.js",
    "build": "electron-builder --win portable --x64",
    "test:hard": "node test/ui/hard-sims.js --all && node test/ui/hard-solve.js"
  },
  "build": {
    "appId": "local.silgi.practice",
    "productName": "SilgiPractice",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "data/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "SilgiPractice"
    },
    "portable": {
      "artifactName": "SilgiPractice-${version}-portable.exe",
      "unpackDirName": "SilgiPractice"
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.65.1",
    "pretendard": "^1.3.9"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bang9lee/silgi-practice.git"
  }
}
